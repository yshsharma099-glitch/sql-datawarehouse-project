/*
===============================================================================
Stored Procedure: Load Silver Layer (Bronze -> Silver)
===============================================================================
Script Purpose:
    This stored procedure performs the ETL (Extract, Transform, Load) process 
    to populate the 'silver' schema tables from the 'bronze' schema.

Actions Performed:
    - Truncates Silver tables
    - Cleans and transforms data
    - Fixes datatype issues
    - Removes duplicates
    - Loads data into Silver tables

Usage:
    EXEC silver.load_silver;
===============================================================================
*/

CREATE OR ALTER PROCEDURE silver.load_silver AS
BEGIN
    DECLARE @start_time DATETIME,
            @end_time DATETIME,
            @batch_start_time DATETIME,
            @batch_end_time DATETIME;

    BEGIN TRY

        SET @batch_start_time = GETDATE();

        PRINT '================================================';
        PRINT 'Loading Silver Layer';
        PRINT '================================================';

        -----------------------------------------------------------------------
        PRINT 'Loading Customer Tables';
        -----------------------------------------------------------------------

        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.customers';
        TRUNCATE TABLE silver.customers;

        PRINT '>> Inserting Data Into: silver.customers';
        INSERT INTO silver.customers
        (
            customer_id,
            first_name,
            last_name,
            phone,
            email,
            street,
            city,
            state,
            zip_code,
            create_date
        )
        SELECT
            customer_id,
            TRIM(first_name) AS first_name,
            TRIM(last_name) AS last_name,
            CASE 
                WHEN phone IS NULL THEN 'n/a'
                WHEN LEN(TRIM(phone)) BETWEEN 7 AND 20 THEN TRIM(phone)
                ELSE 'n/a'
            END AS phone,
            LOWER(TRIM(email)) AS email,
            TRIM(street) AS street,
            TRIM(city) AS city,
            TRIM(state) AS state,
            TRIM(zip_code) AS zip_code,
            TRY_CAST(create_date AS DATE) AS create_date
        FROM
        (
            SELECT *,
                   ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY create_date DESC) AS rn
            FROM bronze.customers
            WHERE customer_id IS NOT NULL
            AND email LIKE '%@%.%'
        ) t
        WHERE rn = 1;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -----------------------------------------------------------------------
        PRINT 'Loading Store Tables';
        -----------------------------------------------------------------------

        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.stores';
        TRUNCATE TABLE silver.stores;
        PRINT '>> Inserting Data Into: silver.stores';
        INSERT INTO silver.stores
        SELECT 
            store_id,
            TRIM(store_name),
            CASE 
                WHEN phone IS NULL THEN 'n/a'
                WHEN LEN(TRIM(phone)) BETWEEN 7 AND 20 THEN TRIM(phone)
                ELSE 'n/a'
            END AS phone,
            LOWER(TRIM(email)),
            TRIM(street),
            TRIM(city),
            UPPER(TRIM(state)),
            TRIM(zip_code)
        FROM bronze.stores
        WHERE store_id IS NOT NULL
        AND LEN(TRIM(phone)) BETWEEN 7 AND 20;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -----------------------------------------------------------------------
        PRINT 'Loading Staff Tables';
        -----------------------------------------------------------------------

        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.staffs';
        TRUNCATE TABLE silver.staffs;
        PRINT '>> Inserting Data Into: silver.staffs';
        INSERT INTO silver.staffs
        SELECT 
            TRY_CAST(staff_id AS INT) AS staff_id,       
            TRIM(first_name) AS first_name,             
            TRIM(last_name) AS last_name,               
            LOWER(TRIM(email)) AS email,                 
            CASE 
                WHEN phone IS NULL THEN 'n/a'
                WHEN LEN(TRIM(phone)) BETWEEN 7 AND 20 THEN TRIM(phone)
                ELSE 'n/a'
            END AS phone,                       
            CASE 
            WHEN active IS NULL THEN NULL
            WHEN TRY_CAST(active AS INT) = 1 THEN 'Active'
            WHEN TRY_CAST(active AS INT) = 0 THEN 'Inactive'
            ELSE 'n/a'
        END AS is_active,        
            TRY_CAST(store_id AS INT) AS store_id,      
            TRY_CAST(manager_id AS INT) AS manager_id   
        FROM bronze.staffs
        WHERE 
        TRY_CAST(staff_id AS INT) IS NOT NULL
        AND TRY_CAST(store_id AS INT) IS NOT NULL;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -----------------------------------------------------------------------
        PRINT 'Loading Product Dimension Tables';
        -----------------------------------------------------------------------

        -- Categories
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.categories';
        TRUNCATE TABLE silver.categories;
        PRINT '>> Inserting Data Into: silver.categories';
        INSERT INTO silver.categories
        SELECT 
            category_id,
            TRIM(category_name) AS category_name
        FROM bronze.categories
        WHERE category_id IS NOT NULL;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -- Brands
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.brands';
        TRUNCATE TABLE silver.brands;
        PRINT '>> Inserting Data Into: silver.brands';
        INSERT INTO silver.brands
        SELECT 
            brand_id,
            TRIM(brand_name) AS brand_name
        FROM bronze.brands
        WHERE brand_id IS NOT NULL;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -- Products
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.products';
        TRUNCATE TABLE silver.products;
        PRINT '>> Inserting Data Into: silver.products';
        INSERT INTO silver.products
        SELECT 
            product_id,
            TRIM(product_name) AS product_name,
            brand_id,
            category_id,
        CASE WHEN model_year < 1900 OR model_year > YEAR(GETDATE()) THEN NULL 
        ELSE model_year END AS model_year,
        CASE 
            WHEN list_price IS NULL THEN 0
            WHEN list_price < 0 THEN ABS(list_price)
            ELSE list_price
        END AS list_price           
        FROM bronze.products
        WHERE 
        product_id IS NOT NULL
        AND brand_id IS NOT NULL
        AND category_id IS NOT NULL;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -----------------------------------------------------------------------
        PRINT 'Loading Orders Tables';
        -----------------------------------------------------------------------

        -- Orders
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.orders';
        TRUNCATE TABLE silver.orders;
        PRINT '>> Inserting Data Into: silver.orders';
        INSERT INTO silver.orders
        SELECT 
            order_id,
            customer_id,
            CASE 
                WHEN order_status = 1 THEN 'Pending'
                WHEN order_status = 2 THEN 'Processing'
                WHEN order_status = 3 THEN 'Shipped'
                WHEN order_status = 4 THEN 'Delivered' 
                ELSE 'n/a'
                END AS order_status,
            TRY_CAST(order_date AS DATE) AS order_date,
            TRY_CAST(required_date AS DATE) AS required_date,
            TRY_CAST(shipped_date AS DATE) AS shipped_date,
            TRY_CAST(store_id AS INT),
            staff_id
        FROM bronze.orders
        WHERE 
        order_id IS NOT NULL
        AND customer_id IS NOT NULL
        AND store_id IS NOT NULL
        AND staff_id IS NOT NULL
        AND TRY_CAST(order_date AS DATE) <= TRY_CAST(required_date AS DATE)
        AND (
            TRY_CAST(order_date AS DATE) <= TRY_CAST(shipped_date AS DATE) 
            OR shipped_date IS NULL
        )
        AND (
            TRY_CAST(shipped_date AS DATE) <= TRY_CAST(required_date AS DATE) 
            OR shipped_date IS NULL
        );

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -- Order Items
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.order_items';
        TRUNCATE TABLE silver.order_items;
        PRINT '>> Inserting Data Into: silver.order_items';
        INSERT INTO silver.order_items
        (
            order_id,
            item_id,
            product_id,
            quantity,
            list_price,
            discount
        )
        SELECT 
            order_id,
            item_id,
            product_id,
        CASE WHEN quantity <= 0 THEN 1 ELSE quantity END AS quantity,
        CASE WHEN list_price <= 0 THEN ABS(list_price) ELSE list_price END AS list_price,
        COALESCE(CASE WHEN discount < 0 OR discount > 1 THEN 0 ELSE discount END,0) AS discount
        FROM bronze.order_items
        WHERE order_id IS NOT NULL
        AND item_id IS NOT NULL
        AND product_id IS NOT NULL;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -- Stocks
        SET @start_time = GETDATE();
        PRINT '>> Truncating Table: silver.stocks';
        TRUNCATE TABLE silver.stocks;
        PRINT '>> Inserting Data Into: silver.stocks';
        INSERT INTO silver.stocks
       SELECT                                           
            CAST(store_id AS INT) AS store_id,
            CAST(product_id AS INT) AS product_id,
            CASE                                  -- Replace NULLs with 0 and ensure no negative inventory values
                WHEN quantity IS NULL THEN 0 
                WHEN quantity < 0 THEN 0 
                ELSE quantity 
            END AS quantity
        FROM bronze.stocks
        WHERE 
        store_id IS NOT NULL
        AND product_id IS NOT NULL;

        SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND,@start_time,@end_time) AS NVARCHAR) + ' seconds';
        PRINT '------------------------------------------------';

        -----------------------------------------------------------------------

        SET @batch_end_time = GETDATE();

        PRINT '==========================================';
        PRINT 'Silver Layer Load Completed Successfully';
        PRINT 'Total Duration: ' 
              + CAST(DATEDIFF(SECOND,@batch_start_time,@batch_end_time) AS NVARCHAR)
              + ' seconds';
        PRINT '==========================================';

    END TRY

    BEGIN CATCH
        PRINT '==========================================';
        PRINT 'ERROR OCCURRED DURING SILVER LOAD';
        PRINT ERROR_MESSAGE();
        PRINT CAST(ERROR_NUMBER() AS NVARCHAR);
        PRINT CAST(ERROR_STATE() AS NVARCHAR);
        PRINT '==========================================';
    END CATCH
END
