-- Products
IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'idx_silver_products_product_id')
CREATE INDEX idx_silver_products_product_id
ON silver.products(product_id);

IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'idx_silver_products_brand_id')
CREATE INDEX idx_silver_products_brand_id
