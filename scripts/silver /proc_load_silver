CREATE OR ALTER PROCEDURE silver.load_silver
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @batch_start_time DATETIME = GETDATE();
    DECLARE @batch_end_time DATETIME;

    PRINT '========================================';
    PRINT 'Starting Silver Layer Load';
    PRINT 'Batch Start Time: ' + CONVERT(VARCHAR(30), @batch_start_time, 120);
    PRINT '========================================';

    BEGIN TRY
        BEGIN TRANSACTION;

        /* =====================================================
        ETL ERRORS TABLE
        ====================================================== */
        IF OBJECT_ID('silver.etl_errors') IS NULL
        BEGIN
            CREATE TABLE silver.etl_errors (
                table_name NVARCHAR(50),
                record_id NVARCHAR(50),
                error_type NVARCHAR(100),
                error_description NVARCHAR(MAX)
                -- created_at removed for compatibility
            );
        END

        /* =====================================================
        CUSTOMERS TRANSFORMATION
        ====================================================== */
        PRINT 'Loading silver.customers...';
        TRUNCATE TABLE silver.customers;

        INSERT INTO silver.customers
        (
            customer_id,
            first_name,
            last_name,
            phone,
            email,
            street,
            city,
            state,
            zip_code
         )
            SELECT
        customer_id,
            CONCAT(UPPER(LEFT(first_name,1)), LOWER(SUBSTRING(first_name,2,LEN(first_name)))
        ) AS first_name,
            CONCAT(UPPER(LEFT(last_name,1)), LOWER(SUBSTRING(last_name,2,LEN(last_name)))
        ) AS last_name,
            NULLIF(TRIM(phone), '') AS phone,
            LOWER(TRIM(email)) AS email,
            TRIM(street) AS street,
            TRIM(city) AS city,
            UPPER(TRIM(state)) AS state,
            TRIM(zip_code) AS zip_code
        FROM(SELECT *,
            ROW_NUMBER() OVER (
                PARTITION BY customer_id 
                ORDER BY cst_create_date
            ) rn
        FROM bronze.customers
        WHERE customer_id IS NOT NULL
        ) t
        WHERE rn = 1;

        PRINT 'Customers Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        /* =====================================================
        ORDERS TRANSFORMATION
        ====================================================== */
        PRINT 'Loading silver.orders...';
        TRUNCATE TABLE silver.orders;

        INSERT INTO silver.orders
        (
            order_id,
            customer_id,
            order_status,
            order_date,
            required_date,
            shipped_date,
            store_id,
            staff_id
        )
       SELECT
        o.order_id,
        o.customer_id,
        CASE WHEN o.order_status NOT IN (1,2,3,4) THEN 1 ELSE o.order_status END AS order_status,
            TRY_CONVERT(DATE, o.order_date) AS order_date,
            TRY_CONVERT(DATE, o.required_date) AS required_date,
            TRY_CONVERT(DATE, o.shipped_date)AS shipped_date,
            TRY_CONVERT(INT, o.store_id)AS store_id,  
            TRY_CONVERT(INT, o.staff_id)AS staff_id
        FROM bronze.orders o;

        PRINT 'Orders Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        /* =====================================================
        ORDER ITEMS TRANSFORMATION
        ====================================================== */
        PRINT 'Loading silver.order_items...';
        TRUNCATE TABLE silver.order_items;

        INSERT INTO silver.order_items
        (
            order_id,
            item_id,
            product_id,
            quantity,
            list_price,
            discount
        )
        SELECT
            oi.order_id,
            oi.item_id,
            oi.product_id,
            CASE WHEN oi.quantity <= 0 THEN 1 ELSE oi.quantity END AS quantity,
            CASE WHEN oi.list_price <= 0 THEN ABS(oi.list_price) ELSE oi.list_price END AS list_price,
            COALESCE(CASE WHEN oi.discount < 0 OR oi.discount > 1 THEN 0 ELSE oi.discount END,0) AS discount
        FROM bronze.order_items oi;

        PRINT 'Order Items Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        /* =====================================================
        PRODUCTS TRANSFORMATION
        ====================================================== */
        PRINT 'Loading silver.products...';
        TRUNCATE TABLE silver.products;

        INSERT INTO silver.products
        (
            product_id,
            product_name,
            brand_id,
            category_id,
            model_year,
            list_price
        )
              SELECT
            p.product_id,
            TRIM(p.product_name) AS product_name,
            TRY_CONVERT(INT,p.brand_id) AS brand_id ,
            TRY_CONVERT(INT,p.category_id) AS category_id, 
            CASE WHEN p.model_year < 1900 OR p.model_year > YEAR(GETDATE()) THEN NULL ELSE p.model_year END AS model_year,
            CASE WHEN p.list_price < 0 THEN ABS(p.list_price) ELSE p.list_price END AS list_price
        FROM bronze.products p;

        PRINT 'Products Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        /* =====================================================
        CATEGORIES & BRANDS CLEANING
        ====================================================== */
        PRINT 'Loading silver.categories...';

        TRUNCATE TABLE silver.categories;
        INSERT INTO silver.categories(category_id, category_name)
        SELECT 
            category_id, 
            TRIM(category_name) AS category_name
        FROM bronze.categories;

        PRINT 'Categories Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        PRINT 'Loading silver.brands...';

        TRUNCATE TABLE silver.brands;
        INSERT INTO silver.brands(brand_id, brand_name)
        SELECT 
            brand_id, 
            TRIM(brand_name) AS brand_name
        FROM bronze.brands;

        PRINT 'Brands Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        /* =====================================================
        STAFFS TRANSFORMATION
        ====================================================== */
        PRINT 'Loading silver.staffs...';
        TRUNCATE TABLE silver.staffs;

        INSERT INTO silver.staffs
        (
            staff_id,
            first_name,
            last_name,
            email,
            phone,
            active,
            store_id,
            manager_id
        )
        SELECT
            s.staff_id,
            TRIM(s.first_name) AS first_name,
            TRIM(s.last_name) AS last_name ,
            LOWER(s.email) AS email ,
            NULLIF(TRIM(s.phone),'') AS phone,
            CASE WHEN s.active NOT IN (0,1) THEN 1 ELSE s.active END AS active, 
            TRY_CONVERT(INT,s.store_id) AS store_id,
            TRY_CONVERT(INT,s.manager_id) AS manager_id
        FROM bronze.staffs s;

        PRINT 'Staffs Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        /* =====================================================
        STORES CLEANING
        ====================================================== */
        PRINT 'Loading silver.stores...';
        TRUNCATE TABLE silver.stores;

        INSERT INTO silver.stores
        (
            store_id,
            store_name,
            phone,
            email,
            street,
            city,
            state,
            zip_code
        )
        SELECT
            store_id,
            TRIM(store_name) AS store_name,
            CASE 
                WHEN LEN(TRIM(phone)) > 10 THEN 'n/a'
                ELSE NULLIF(TRIM(phone), '') 
            END AS phone,
            LOWER(TRIM(email)) AS email ,
            TRIM(street) AS street,
            TRIM(city) AS city,
            UPPER(TRIM(state)) AS state,
            TRIM(zip_code) AS zip_code
        FROM bronze.stores;

        PRINT 'Stores Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        /* =====================================================
        STOCKS TRANSFORMATION
        ====================================================== */
        PRINT 'Loading silver.stocks...';
        TRUNCATE TABLE silver.stocks;

        INSERT INTO silver.stocks
        (
            store_id,
            product_id,
            quantity
        )
        SELECT
            TRY_CONVERT(INT,store_id) AS store_id,
            TRY_CONVERT(INT,product_id) AS product_id,
            CASE WHEN quantity < 0 THEN 0 ELSE quantity END AS quantity
        FROM bronze.stocks;

        PRINT 'Stocks Loaded: ' + CAST(@@ROWCOUNT AS VARCHAR);

        COMMIT TRANSACTION;

        SET @batch_end_time = GETDATE();
        PRINT '========================================';
        PRINT 'Silver Layer Completed';
        PRINT 'Total Duration: ' + CAST(DATEDIFF(SECOND,@batch_start_time,@batch_end_time) AS VARCHAR) + ' seconds';
        PRINT '========================================';

    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;

        -- Log error without 'created_at' to avoid column issues
        INSERT INTO silver.etl_errors (table_name, error_type, error_description)
        VALUES ('silver.load_silver', 'Procedure Failure', ERROR_MESSAGE());

        PRINT '========================================';
        PRINT 'ERROR IN SILVER LOAD: ' + ERROR_MESSAGE();
        PRINT '========================================';
    END CATCH;

END;
GO

/* =====================================================
PERFORMANCE INDEXES FOR SILVER LAYER
Improves joins between Silver -> Gold
===================================================== */

