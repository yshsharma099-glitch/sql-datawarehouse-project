/*
===============================================================================
DDL Script: Gold Layer (Business-Ready)
===============================================================================
*/

IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = 'gold')
BEGIN
    EXEC('CREATE SCHEMA gold');
END
GO


-- =============================================================================
-- Dimension: Customers
-- =============================================================================
CREATE OR ALTER VIEW gold.dim_customers AS
SELECT
    ROW_NUMBER() OVER (ORDER BY c.customer_id) AS customer_key,
    c.customer_id,
    CONCAT(c.first_name,' ',c.last_name) AS full_name,
    c.phone,
    c.email,
    c.street,
    c.city,
    c.state,
    c.zip_code
FROM silver.customers c;
GO


-- =============================================================================
-- Dimension: Products
-- =============================================================================
CREATE OR ALTER VIEW gold.dim_products AS
SELECT
    ROW_NUMBER() OVER (ORDER BY p.product_id) AS product_key,
    p.product_id,
    p.product_name,
    b.brand_name,
    c.category_name,
    p.model_year,
    p.list_price
FROM silver.products p
LEFT JOIN silver.brands b
    ON p.brand_id = b.brand_id
LEFT JOIN silver.categories c
    ON p.category_id = c.category_id;
GO


-- =============================================================================
-- Dimension: Stores
-- =============================================================================
CREATE OR ALTER VIEW gold.dim_stores AS
SELECT
    ROW_NUMBER() OVER (ORDER BY s.store_id) AS store_key,
    s.store_id,
    s.store_name,
    s.phone,
    s.email,
    s.street,
    s.city,
    s.state,
    s.zip_code
FROM silver.stores s;
GO


-- =============================================================================
-- Dimension: Staffs
-- =============================================================================
CREATE OR ALTER VIEW gold.dim_staffs AS
SELECT
    ROW_NUMBER() OVER (ORDER BY st.staff_id) AS staff_key,
    st.staff_id,
    CONCAT(st.first_name,' ',st.last_name) AS staff_name,
    st.email,
    st.phone,
    CASE 
        WHEN st.active = 1 THEN 'Active'
        ELSE 'Inactive'
    END AS staff_status,
    st.store_id,
    st.manager_id
FROM silver.staffs st;
GO


-- =============================================================================
-- Fact Table: Sales
-- =============================================================================
CREATE OR ALTER VIEW gold.fact_sales AS
SELECT
    o.order_id,
    CASE 
        WHEN o.order_status = 1 THEN 'Pending'
        WHEN o.order_status = 2 THEN 'Processing'
        WHEN o.order_status = 3 THEN 'Shipped'
        WHEN o.order_status = 4 THEN 'Delivered'
        ELSE 'Unknown'
    END AS order_status,
    dp.product_key,
    dc.customer_key,
    ds.store_key,
    df.staff_key,
    o.order_date,
    o.required_date,
    o.shipped_date,
    oi.quantity,
    oi.list_price AS unit_price,
    oi.discount,
    (oi.quantity * oi.list_price * (1 - oi.discount)) AS sales_amount

FROM silver.orders o
JOIN silver.order_items oi
    ON o.order_id = oi.order_id
LEFT JOIN gold.dim_products dp
    ON oi.product_id = dp.product_id
LEFT JOIN gold.dim_customers dc
    ON o.customer_id = dc.customer_id
LEFT JOIN gold.dim_stores ds
    ON o.store_id = ds.store_id
LEFT JOIN gold.dim_staffs df
    ON o.staff_id = df.staff_id;
GO


-- =============================================================================
-- Fact Table: Stocks
-- =============================================================================
CREATE OR ALTER VIEW gold.fact_stocks AS
SELECT
    dp.product_key,
    ds.store_key,
    st.quantity
FROM silver.stocks st
LEFT JOIN gold.dim_products dp
    ON st.product_id = dp.product_id
LEFT JOIN gold.dim_stores ds
    ON st.store_id = ds.store_id;
GO
