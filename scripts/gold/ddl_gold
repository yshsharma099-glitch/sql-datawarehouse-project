/*
===============================================================================
DDL Script: Create Gold Views
===============================================================================
Purpose:
    Create the Gold Layer semantic model using views.

 The Gold layer represents the final analytics-ready model (Star Schema)
    optimized for reporting tools like Power BI.

    Data Source:
        Silver Layer (Cleaned and Validated Data)

    Core Entities:
        Fact Table  : fact_sales
        Dimensions  : customers, products, stores, staff, date

Business Logic Implemented:
    - Surrogate keys for all dimensions
    - Net sales calculation
    - Delivery performance metric
===============================================================================
*/

-- =============================================================================
-- Create Dimension: gold.dim_customers
-- =============================================================================
IF OBJECT_ID('gold.dim_customers', 'V') IS NOT NULL
    DROP VIEW gold.dim_customers;
GO

CREATE VIEW gold.dim_customers AS
SELECT
    ROW_NUMBER() OVER (ORDER BY customer_id) AS customer_key, -- Surrogate key
    customer_id,
    CONCAT(first_name, ' ', last_name) AS customer_name,
    city,
    state,
    zip_code,
    create_date
FROM silver.customers;
GO

-- =============================================================================
-- Create Dimension: gold.dim_products
-- =============================================================================
IF OBJECT_ID('gold.dim_products', 'V') IS NOT NULL
    DROP VIEW gold.dim_products;
GO

CREATE VIEW gold.dim_products AS
SELECT
    ROW_NUMBER() OVER (ORDER BY p.product_id) AS product_key, -- Surrogate key
    p.product_id,
    p.product_name,
    b.brand_name,
    c.category_name,
    p.model_year,
    p.list_price
FROM silver.products p
LEFT JOIN silver.brands b
    ON p.brand_id = b.brand_id
LEFT JOIN silver.categories c
    ON p.category_id = c.category_id;
GO

-- =============================================================================
-- Create Dimension: gold.dim_stores
-- =============================================================================
IF OBJECT_ID('gold.dim_stores', 'V') IS NOT NULL
    DROP VIEW gold.dim_stores;
GO

CREATE VIEW gold.dim_stores AS
SELECT
    ROW_NUMBER() OVER (ORDER BY store_id) AS store_key, -- Surrogate key
    store_id,
    store_name,
    city,
    state,
    zip_code,
    phone,
    email
FROM silver.stores;
GO

-- =============================================================================
-- Create Dimension: gold.dim_staff
-- =============================================================================
IF OBJECT_ID('gold.dim_staff', 'V') IS NOT NULL
    DROP VIEW gold.dim_staff;
GO

CREATE VIEW gold.dim_staff AS
SELECT
    ROW_NUMBER() OVER (ORDER BY s.staff_id) AS staff_key, -- Surrogate key
    s.staff_id,
    CONCAT(s.first_name,' ',s.last_name) AS staff_name,
    s.email,
    s.phone,
    s.active,
    s.store_id,
    CONCAT(m.first_name,' ',m.last_name) AS manager_name
FROM silver.staffs s
LEFT JOIN silver.staffs m
    ON s.manager_id = m.staff_id;
GO

-- =============================================================================
-- Create Dimension: gold.dim_date
-- =============================================================================
IF OBJECT_ID('gold.dim_date', 'V') IS NOT NULL
    DROP VIEW gold.dim_date;
GO

CREATE VIEW gold.dim_date AS
SELECT DISTINCT
    ROW_NUMBER() OVER (ORDER BY order_date) AS date_key,
    order_date AS full_date,
    YEAR(order_date) AS year,
    MONTH(order_date) AS month,
    DATENAME(MONTH, order_date) AS month_name,
    DATEPART(QUARTER, order_date) AS quarter,
    DATEPART(WEEK, order_date) AS week,
    DATENAME(WEEKDAY, order_date) AS day_name
FROM silver.orders
WHERE order_date IS NOT NULL;
GO

-- =============================================================================
-- Create Fact Table: gold.fact_sales
-- =============================================================================
IF OBJECT_ID('gold.fact_sales', 'V') IS NOT NULL
    DROP VIEW gold.fact_sales;
GO

CREATE VIEW gold.fact_sales AS
SELECT
    o.order_id,
    dp.product_key,
    dc.customer_key,
    ds.store_key,
    dst.staff_key,
    dd.date_key,
    o.order_date,
    o.required_date,
    o.shipped_date,
    oi.quantity,
    oi.list_price,
    oi.discount,
    -- Business metrics
    (oi.quantity * oi.list_price) AS gross_sales,
    (oi.quantity * oi.list_price * (1 - oi.discount)) AS net_sales,
    DATEDIFF(day, o.order_date, o.shipped_date) AS shipping_days
FROM silver.orders o
JOIN silver.order_items oi
    ON o.order_id = oi.order_id
LEFT JOIN gold.dim_products dp
    ON oi.product_id = dp.product_id
LEFT JOIN gold.dim_customers dc
    ON o.customer_id = dc.customer_id
LEFT JOIN gold.dim_stores ds
    ON o.store_id = ds.store_id
LEFT JOIN gold.dim_staff dst
    ON o.staff_id = dst.staff_id
LEFT JOIN gold.dim_date dd
    ON o.order_date = dd.full_date;
GO
