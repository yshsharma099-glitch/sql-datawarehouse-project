/*
===============================================================================
DDL Script: Create Bronze Tables
===============================================================================
*/

IF OBJECT_ID('bronze.customers', 'U') IS NOT NULL DROP TABLE bronze.customers;
CREATE TABLE bronze.customers (
    customer_id NVARCHAR(500),
    first_name NVARCHAR(500), 
    last_name NVARCHAR(500), 
    phone NVARCHAR(500),
    email NVARCHAR(500), 
    street NVARCHAR(500), 
    city NVARCHAR(500), 
    state NVARCHAR(500), 
    zip_code NVARCHAR(500)
);

IF OBJECT_ID('bronze.orders', 'U') IS NOT NULL DROP TABLE bronze.orders;
CREATE TABLE bronze.orders (
    order_id NVARCHAR(500), 
    customer_id NVARCHAR(500), 
    order_status NVARCHAR(500), 
    order_date NVARCHAR(500),
    required_date NVARCHAR(500), 
    shipped_date NVARCHAR(500), 
    store_id NVARCHAR(500), 
    staff_id NVARCHAR(500)
);

IF OBJECT_ID('bronze.order_items', 'U') IS NOT NULL DROP TABLE bronze.order_items;
CREATE TABLE bronze.order_items (
    order_id NVARCHAR(500),
    item_id NVARCHAR(500), 
    product_id NVARCHAR(500), 
    quantity NVARCHAR(500),
    list_price NVARCHAR(500),
    discount NVARCHAR(500)
);

IF OBJECT_ID('bronze.products', 'U') IS NOT NULL DROP TABLE bronze.products;
CREATE TABLE bronze.products (
    product_id NVARCHAR(500), 
    product_name NVARCHAR(500),
    brand_id NVARCHAR(500), 
    category_id NVARCHAR(500),
    model_year NVARCHAR(500), 
    list_price NVARCHAR(500)
);

IF OBJECT_ID('bronze.staffs', 'U') IS NOT NULL DROP TABLE bronze.staffs;
CREATE TABLE bronze.staffs (
    staff_id NVARCHAR(500),
    first_name NVARCHAR(500),
    last_name NVARCHAR(500), 
    email NVARCHAR(500), 
    phone NVARCHAR(500), 
    active NVARCHAR(500), 
    store_id NVARCHAR(500), 
    manager_id NVARCHAR(500)
);

IF OBJECT_ID('bronze.stores', 'U') IS NOT NULL DROP TABLE bronze.stores;
CREATE TABLE bronze.stores (
    store_id NVARCHAR(500), 
    store_name NVARCHAR(500), 
    phone NVARCHAR(500), 
    email NVARCHAR(500), 
    street NVARCHAR(500), 
    city NVARCHAR(500), 
    state NVARCHAR(500),
    zip_code NVARCHAR(500)
);

IF OBJECT_ID('bronze.stocks', 'U') IS NOT NULL DROP TABLE bronze.stocks;
CREATE TABLE bronze.stocks (
    store_id NVARCHAR(500), 
    product_id NVARCHAR(500),
    quantity NVARCHAR(500)
);

IF OBJECT_ID('bronze.brands', 'U') IS NOT NULL DROP TABLE bronze.brands;
CREATE TABLE bronze.brands (
    brand_id NVARCHAR(500),
    brand_name NVARCHAR(500)
);

IF OBJECT_ID('bronze.categories', 'U') IS NOT NULL DROP TABLE bronze.categories;
CREATE TABLE bronze.categories (
    category_id NVARCHAR(500), 
    category_name NVARCHAR(500)
);
GO

ALTER TABLE bronze.customers
ADD cst_create_date DATE;
