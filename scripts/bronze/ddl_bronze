/*
===============================================================================
DDL Script: Create Bronze Tables
===============================================================================
Script Purpose:
    This script creates all tables in the 'bronze' schema as used in the 
    bronze.load_bronze procedure.
    Existing tables are dropped if they exist.
===============================================================================
*/

-- ==========================================
-- 1. Customers Table
-- ==========================================
IF OBJECT_ID('bronze.customers','U') IS NOT NULL
    DROP TABLE bronze.customers;
GO

CREATE TABLE bronze.customers
(
    customer_id INT,
    first_name NVARCHAR(50),
    last_name NVARCHAR(50),
    phone NVARCHAR(50),
    email NVARCHAR(100),
    street NVARCHAR(100),
    city NVARCHAR(50),
    state NVARCHAR(50),
    zip_code NVARCHAR(20)
);
GO

-- ==========================================
-- 2. Staging Customers Table
-- ==========================================
IF OBJECT_ID('bronze.stg_customers','U') IS NOT NULL
    DROP TABLE bronze.stg_customers;
GO

CREATE TABLE bronze.stg_customers
(
    customer_id NVARCHAR(50),
    first_name NVARCHAR(255),
    last_name NVARCHAR(255),
    phone NVARCHAR(50),
    email NVARCHAR(255),
    street NVARCHAR(255),
    city NVARCHAR(100),
    state NVARCHAR(100),
    zip_code NVARCHAR(50)
);
GO

-- ==========================================
-- 3. Orders Table
-- ==========================================
IF OBJECT_ID('bronze.orders','U') IS NOT NULL
    DROP TABLE bronze.orders;
GO

CREATE TABLE bronze.orders
(
    order_id INT,
    customer_id INT,
    staff_id INT,
    store_id INT,
    order_date DATE,
    shipped_date DATE,
    status NVARCHAR(50)
);
GO

-- ==========================================
-- 4. Order Items Table
-- ==========================================
IF OBJECT_ID('bronze.order_items','U') IS NOT NULL
    DROP TABLE bronze.order_items;
GO

CREATE TABLE bronze.order_items
(
    order_item_id INT,
    order_id INT,
    product_id INT,
    quantity INT,
    list_price DECIMAL(10,2),
    discount DECIMAL(5,2)
);
GO

-- ==========================================
-- 5. Products Table
-- ==========================================
IF OBJECT_ID('bronze.products','U') IS NOT NULL
    DROP TABLE bronze.products;
GO

CREATE TABLE bronze.products
(
    product_id INT,
    product_name NVARCHAR(100),
    brand_id INT,
    category_id INT,
    model_year INT,
    list_price DECIMAL(10,2)
);
GO

-- ==========================================
-- 6. Categories Table
-- ==========================================
IF OBJECT_ID('bronze.categories','U') IS NOT NULL
    DROP TABLE bronze.categories;
GO

CREATE TABLE bronze.categories
(
    category_id INT,
    category_name NVARCHAR(50)
);
GO

-- ==========================================
-- 7. Brands Table
-- ==========================================
IF OBJECT_ID('bronze.brands','U') IS NOT NULL
    DROP TABLE bronze.brands;
GO

CREATE TABLE bronze.brands
(
    brand_id INT,
    brand_name NVARCHAR(50)
);
GO

-- ==========================================
-- 8. Staffs Table
-- ==========================================
IF OBJECT_ID('bronze.staffs','U') IS NOT NULL
    DROP TABLE bronze.staffs;
GO

CREATE TABLE bronze.staffs
(
    staff_id INT,
    first_name NVARCHAR(50),
    last_name NVARCHAR(50),
    email NVARCHAR(100),
    phone NVARCHAR(50),
    active BIT,
    store_id INT,
    manager_id INT
);
GO

-- ==========================================
-- 9. Stores Table
-- ==========================================
IF OBJECT_ID('bronze.stores','U') IS NOT NULL
    DROP TABLE bronze.stores;
GO

CREATE TABLE bronze.stores
(
    store_id INT,
    store_name NVARCHAR(100),
    phone NVARCHAR(50),
    email NVARCHAR(100),
    street NVARCHAR(100),
    city NVARCHAR(50),
    state NVARCHAR(50),
    zip_code NVARCHAR(20)
);
GO

-- ==========================================
-- 10. Stocks Table
-- ==========================================
IF OBJECT_ID('bronze.stocks','U') IS NOT NULL
    DROP TABLE bronze.stocks;
GO

CREATE TABLE bronze.stocks
(
    store_id INT,
    product_id INT,
    quantity INT
);
GO

-- ==========================================
-- 11. Error Log Table
-- ==========================================
IF OBJECT_ID('bronze.load_errors','U') IS NOT NULL
    DROP TABLE bronze.load_errors;
GO

CREATE TABLE bronze.load_errors
(
    table_name NVARCHAR(50),
    row_number INT,
    error_message NVARCHAR(500),
    load_time DATETIME DEFAULT GETDATE()
);
GO
