/* =========================================================
   CUSTOMER FAVORITE CATEGORY
   ========================================================= */

IF OBJECT_ID('analytics.customer_favorite_category','V') IS NOT NULL
DROP VIEW analytics.customer_favorite_category;
GO

CREATE VIEW analytics.customer_favorite_category AS
SELECT *
FROM
(
    SELECT
        f.customer_key,
        p.category_name,
        SUM(f.net_sales) AS category_spend,
        ROW_NUMBER() OVER
        (
            PARTITION BY f.customer_key
            ORDER BY SUM(f.net_sales) DESC
        ) AS rn
    FROM analytics.fact_sales f
    JOIN analytics.dim_products p
        ON f.product_key = p.product_key
    GROUP BY
        f.customer_key,
        p.category_name
) t
WHERE rn = 1;
GO

/* =========================================================
   CUSTOMER 360 VIEW
   ========================================================= */

IF OBJECT_ID('analytics.customer_360_view','V') IS NOT NULL
DROP VIEW analytics.customer_360_view;
GO

CREATE VIEW analytics.customer_360_view AS
SELECT
    c.customer_key,
    c.customer_name,
    c.city,
    c.state,
    c.zip_code,
    COUNT(DISTINCT f.order_id) AS total_orders,
    SUM(f.net_sales) AS total_spend,
    AVG(f.discount) AS avg_discount_used,
    MAX(f.order_date) AS last_purchase_date,
    DATEDIFF(day, MAX(f.order_date), GETDATE()) AS days_since_last_purchase,
    COUNT(DISTINCT p.category_name) AS categories_purchased
FROM analytics.dim_customers c
LEFT JOIN analytics.fact_sales f
    ON c.customer_key = f.customer_key
LEFT JOIN analytics.dim_products p
    ON f.product_key = p.product_key
GROUP BY
    c.customer_key,
    c.customer_name,
    c.city,
    c.state,
    c.zip_code;
GO



