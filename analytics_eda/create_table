/* =========================================================
   CREATE ANALYTICS DATABASE 
   ========================================================= */
IF DB_ID('BikestoreAnalytics') IS NULL
CREATE DATABASE BikestoreAnalytics;
GO

USE BikestoreAnalytics;
GO

/* =========================================================
   CREATE SCHEMA
   ========================================================= */
IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = 'analytics')
EXEC('CREATE SCHEMA analytics');
GO

/*
=============================================================
Create Analytics Tables (Mirror Gold Layer)
=============================================================
Purpose:
    Copy the curated business-ready data from the Gold layer
    into physical tables for faster analytics queries.

Reason:
    Views are slower for heavy analysis and ML workloads.
    Therefore we materialize them as tables here.
=============================================================
*/

/* =========================================================
   DIM CUSTOMERS
   ========================================================= */

IF OBJECT_ID('analytics.dim_customers','U') IS NULL
BEGIN
    SELECT *
    INTO analytics.dim_customers
    FROM BikestoreDW.gold.dim_customers;
END
ELSE
BEGIN
    TRUNCATE TABLE analytics.dim_customers;

    INSERT INTO analytics.dim_customers
    SELECT *
    FROM BikestoreDW.gold.dim_customers;
END
GO


