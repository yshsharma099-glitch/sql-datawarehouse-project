/*
=============================================================
Customer Segmentation
=============================================================
Purpose:
    Identify high-value customers.
=============================================================
*/

WITH customer_sales AS
(
SELECT
    customer_key,
    SUM(sales_amount) total_spending
FROM analytics.fact_sales
GROUP BY customer_key
)

SELECT
    CASE
        WHEN total_spending > 5000 THEN 'High Value'
        WHEN total_spending > 1000 THEN 'Mid Value'
        ELSE 'Low Value'
    END segment,
    COUNT(*) customers
FROM customer_sales
GROUP BY
CASE
    WHEN total_spending > 5000 THEN 'High Value'
    WHEN total_spending > 1000 THEN 'Mid Value'
    ELSE 'Low Value'
END;

--Top Customers (Customer Lifetime Value Analysis)

SELECT TOP 10
    dc.full_name,
    SUM(fs.sales_amount) AS total_spent,
    COUNT(DISTINCT fs.order_id) AS total_orders
FROM gold.fact_sales fs
JOIN gold.dim_customers dc
    ON fs.customer_key = dc.customer_key
GROUP BY dc.full_name
ORDER BY total_spent DESC;


-- Customer Segmentation

WITH customer_metrics AS (
    SELECT
        customer_key,
        MAX(order_date) AS last_order,
        COUNT(order_id) AS frequency,
        SUM(sales_amount) AS monetary
    FROM gold.fact_sales
    GROUP BY customer_key
),
rfm AS (
    SELECT
        customer_key,
        DATEDIFF(day, last_order, GETDATE()) AS recency,
        frequency,
        monetary
    FROM customer_metrics
)
SELECT
    customer_key,
    recency,
    frequency,
    monetary,
    NTILE(4) OVER (ORDER BY recency DESC) AS recency_score,
    NTILE(4) OVER (ORDER BY frequency) AS frequency_score,
    NTILE(4) OVER (ORDER BY monetary) AS monetary_score
FROM rfm;


