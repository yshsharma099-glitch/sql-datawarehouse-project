/*
=============================================================
Business Insights Report
=============================================================
*/

SELECT
    YEAR(order_date) year,
    SUM(sales_amount) revenue,
    SUM(quantity) units_sold,
    COUNT(DISTINCT order_id) orders
FROM analytics.fact_sales
GROUP BY YEAR(order_date)
ORDER BY year;

/* 

