/*
=============================================================
Cumulative Sales Growth
=============================================================
Purpose:
    Track business growth over time.
=============================================================
*/

SELECT
    order_month,
    revenue,
    SUM(revenue) OVER (ORDER BY order_month) running_revenue
FROM
(
SELECT
    DATETRUNC(month, order_date) order_month,
    SUM(sales_amount) revenue
FROM analytics.fact_sales
GROUP BY DATETRUNC(month, order_date)
)t;

--This helps measure Business expansion and Long-term revenue trajectory.
