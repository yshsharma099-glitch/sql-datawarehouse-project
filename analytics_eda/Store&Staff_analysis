--Store Performance Ranking

SELECT
    ds.store_name,
    SUM(fs.sales_amount) AS revenue,
    RANK() OVER (ORDER BY SUM(fs.sales_amount) DESC) AS store_rank
FROM gold.fact_sales fs
JOIN gold.dim_stores ds
    ON fs.store_key = ds.store_key
GROUP BY ds.store_name;

--Staff Performance

SELECT
    df.staff_name,
    COUNT(DISTINCT fs.order_id) AS orders_handled,
    SUM(fs.sales_amount) AS revenue_generated,
    AVG(fs.sales_amount) AS avg_order_value
FROM gold.fact_sales fs
JOIN gold.dim_staffs df
    ON fs.staff_key = df.staff_key
GROUP BY df.staff_name
ORDER BY revenue_generated DESC;
