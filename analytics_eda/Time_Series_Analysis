/* =========================================================
   MONTHLY REVENUE GROWTH ANALYSIS
   ========================================================= */

WITH revenue AS (
    SELECT
        DATEFROMPARTS(YEAR(order_date), MONTH(order_date), 1) AS month,
        SUM(sales_amount) AS revenue
    FROM gold.fact_sales
    GROUP BY DATEFROMPARTS(YEAR(order_date), MONTH(order_date), 1)
)
SELECT
    month,
    ROUND(revenue, 2) AS revenue,
    ROUND(LAG(revenue) OVER (ORDER BY month), 2) AS prev_month_revenue,
    FORMAT(
        (revenue - LAG(revenue) OVER (ORDER BY month))
        / NULLIF(LAG(revenue) OVER (ORDER BY month), 0) * 100,
        'N2'
    ) + '%' AS growth
FROM revenue
ORDER BY month;


/*
=============================================================
Year over Year Growth
=============================================================
Purpose: Compare yearly business performance.
=============================================================
*/

WITH yearly_sales AS
(
SELECT
    YEAR(order_date) year,
    SUM(sales_amount) revenue
FROM analytics.fact_sales
GROUP BY YEAR(order_date)
)

SELECT
    year,
    revenue,
    LAG(revenue) OVER (ORDER BY year) prev_year_sales,
    revenue - LAG(revenue) OVER (ORDER BY year) growth
FROM yearly_sales;
